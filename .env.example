# ── CuraVision — Docker Compose orchestration (.env at repo root) ─────────────
# Copy to .env and fill in real secrets. NEVER commit .env.
#
#   cp .env.example .env
#
# Used exclusively by `docker compose up`. For local npm/python dev, also
# configure backend/.env and ai-service/.env (see those .env.example files).

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=curavision
POSTGRES_PASSWORD=change-me-strong-db-password
POSTGRES_DB=curavision

# ── MinIO ─────────────────────────────────────────────────────────────────────
MINIO_ROOT_USER=curavision
MINIO_ROOT_PASSWORD=change-me-strong-minio-password

# ── Auth ──────────────────────────────────────────────────────────────────────
# Generate: openssl rand -hex 32
# Must match backend/.env JWT_SECRET.
JWT_SECRET=replace-with-openssl-rand-hex-32

# ── Service-to-service auth ───────────────────────────────────────────────────
# Must match backend/.env and ai-service/.env exactly.
# Generate: openssl rand -hex 32
INTERNAL_SERVICE_TOKEN=replace-with-openssl-rand-hex-32

# ── AI / LLM ──────────────────────────────────────────────────────────────────
LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama3-8b-8192

# ── Frontend (baked at Docker build time) ─────────────────────────────────────
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:3000

# ── Public backend URL ────────────────────────────────────────────────────────
BACKEND_URL=http://localhost:3001

# ── SMTP (optional — email verification, notifications) ───────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="CuraVision" <noreply@curavision.app>
