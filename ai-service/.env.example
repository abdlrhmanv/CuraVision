# ── Service ───────────────────────────────────────────────────────────────────
PORT=8001

# ── LLM provider ──────────────────────────────────────────────────────────────
# Pick one: "groq" (hosted) or "ollama" (local).
LLM_PROVIDER=groq

# Groq settings — required when LLM_PROVIDER=groq.
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama3-8b-8192

# Ollama settings — used when LLM_PROVIDER=ollama.
# Default points at a local `ollama serve` instance on the host.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# ── ChromaDB ──────────────────────────────────────────────────────────────────
# Leave CHROMA_HOST empty to use an embedded (in-process) Chroma client.
# Point at the server container (`chromadb`) when running under Docker Compose.
CHROMA_HOST=
CHROMA_PORT=8000

# ── Async pipeline (Celery + Redis) ───────────────────────────────────────────
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Where the Celery worker should POST analysis-complete callbacks.
BACKEND_CALLBACK_URL=http://localhost:3001
