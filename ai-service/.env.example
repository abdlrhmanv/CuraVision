# ── CuraVision AI Service — environment template ──────────────────────────────
# Copy to .env:  cp .env.example .env
# NEVER commit .env.

# ── Service ───────────────────────────────────────────────────────────────────
PORT=8001

# ── Service-to-service auth ───────────────────────────────────────────────────
# Must match backend/.env and root .env exactly.
# Generate: openssl rand -hex 32
INTERNAL_SERVICE_TOKEN=replace-with-openssl-rand-hex-32

# ── LLM provider ──────────────────────────────────────────────────────────────
LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama3-8b-8192

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# ── ChromaDB (RAG) ────────────────────────────────────────────────────────────
# Empty = embedded client. Local docker: localhost. Compose: chromadb
CHROMA_HOST=
CHROMA_PORT=8000

# ── Celery + Redis ────────────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Local dev: http://localhost:3001
# Docker worker: http://backend:3001
BACKEND_CALLBACK_URL=http://localhost:3001

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3001

# ── ONNX inference ────────────────────────────────────────────────────────────
INFERENCE_STRATEGY=onnx
