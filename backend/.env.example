# ── CuraVision Backend — environment template ─────────────────────────────────
# Copy to .env:  cp .env.example .env
# NEVER commit .env.

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
LOG_LEVEL=debug

# ── Auth ──────────────────────────────────────────────────────────────────────
# Generate: openssl rand -hex 32
JWT_SECRET=replace-with-openssl-rand-hex-32
# Recommended separate refresh secret. Generate: openssl rand -hex 32
JWT_REFRESH_SECRET=replace-with-openssl-rand-hex-32

# ── Service-to-service auth ───────────────────────────────────────────────────
# Must match ai-service/.env and root .env exactly.
# Generate: openssl rand -hex 32
INTERNAL_SERVICE_TOKEN=replace-with-openssl-rand-hex-32

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://curavision:curavision@localhost:5432/curavision?schema=public&connection_limit=20

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/1

# ── AI microservice ───────────────────────────────────────────────────────────
# Local dev:  http://localhost:8001
# Docker:     http://ai-service:8001
AI_SERVICE_URL=http://localhost:8001

# ── Public URLs ───────────────────────────────────────────────────────────────
BACKEND_URL=http://localhost:3001

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated browser origins.
CORS_ORIGIN=http://localhost:3000

# ── Storage ───────────────────────────────────────────────────────────────────
STORAGE_PATH=
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=curavision
S3_ACCESS_KEY=curavision
S3_SECRET_KEY=curavision

# ── Rate limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10

# ── SMTP (optional) ───────────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="CuraVision" <noreply@curavision.app>
