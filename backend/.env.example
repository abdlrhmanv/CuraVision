# ── Server ────────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ── Auth ──────────────────────────────────────────────────────────────────────
# Change before shipping to any shared environment.
JWT_SECRET=curavision_dev_secret_change_in_production

# ── AI service ────────────────────────────────────────────────────────────────
AI_SERVICE_URL=http://localhost:8001

# ── Storage ───────────────────────────────────────────────────────────────────
# Absolute or relative path for uploaded DICOMs / derived assets.
# Defaults to <repo>/backend/storage when unset.
STORAGE_PATH=

# ── Database ──────────────────────────────────────────────────────────────────
# Required once Prisma is wired in (see backend/prisma/schema.prisma).
# docker-compose up postgres exposes it on 5432 with these credentials.
DATABASE_URL=postgresql://curavision:curavision@localhost:5432/curavision?schema=public&connection_limit=20

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed browser origins. Use "*" for dev only.
CORS_ORIGIN=http://localhost:3000

# ── Rate limiting ─────────────────────────────────────────────────────────────
# Generic /api/* window + request cap.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
# Stricter window + cap for /api/auth/* (brute-force protection).
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10

# ── S3 / MinIO Storage Integration ────────────────────────────────────────────
# Set S3_ENDPOINT to enable S3 storage (e.g. http://localhost:9000 for local MinIO).
# Leave S3_ENDPOINT empty to fallback to local filesystem storage.
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=curavision
S3_ACCESS_KEY=curavision
S3_SECRET_KEY=curavision
