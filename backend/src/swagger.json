{
  "openapi": "3.0.0",
  "info": {
    "title": "CuraVision API",
    "version": "1.0.0",
    "description": "API documentation for the CuraVision medical platform."
  },
  "servers": [
    {
      "url": "http://localhost:3001/api",
      "description": "Local development server"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  },
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/auth/login": {
      "post": {
        "summary": "Login a user",
        "tags": ["Auth"],
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": { "type": "string" },
                  "password": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Successful login" }
        }
      }
    },
    "/scans": {
      "post": {
        "summary": "Upload a new DICOM scan",
        "tags": ["Scans"],
        "responses": {
          "200": { "description": "Scan uploaded and queued for analysis" }
        }
      }
    },
    "/scans/{id}/status-stream": {
      "get": {
        "summary": "SSE endpoint for live scan analysis progress",
        "tags": ["Scans"],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "token", "in": "query", "description": "JWT token", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "SSE stream connected" }
        }
      }
    },
    "/health": {
      "get": {
        "summary": "Health check",
        "tags": ["System"],
        "security": [],
        "responses": {
          "200": { "description": "System is healthy" }
        }
      }
    }
  }
}
